# Secret used to sign session tokens (generate a random 32+ char string)
JWT_SECRET=your-secret-key-change-this-in-production

# Resend API key for sending emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend webhook signing secret (from Resend dashboard)
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin email address (used during initial setup)
ADMIN_EMAIL=admin@yourdomain.com

# 256-bit AES-GCM key used to encrypt per-domain secrets (e.g. domain-scoped
# Resend API keys) stored in D1. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Previous ENCRYPTION_KEY, set during rotation. Ciphertexts written with the
# old key keep decrypting until you re-save the affected secrets. Once
# re-saved, unset this var.
# ENCRYPTION_KEY_V1=

# Retention thresholds (days). Messages older than SOFT are hidden from the
# UI; messages older than HARD are deleted from D1 and R2 by the daily cron.
# Defaults: 180 / 210.
# RETENTION_SOFT_DELETE_DAYS=180
# RETENTION_HARD_DELETE_DAYS=210

# ── Cloudflare API Integration (optional) ──────────────────────────────
# Enables one-click domain setup: auto-configures DNS, DKIM, Email Routing.
# Create a token at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions (Zone-level, all zones):
#   Zone Read, DNS Write, Zone Settings Write, Email Routing Rules Write
# Optional: Account Analytics Read (for storage stats page)

# Cloudflare API token
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID (found on dashboard homepage → API section)
CLOUDFLARE_ACCOUNT_ID=

# Worker name for catch-all rule (defaults to "edgemail" if omitted)
# CF_WORKER_NAME=edgemail
