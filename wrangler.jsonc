{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgemail",
  "main": "src/server/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets (React SPA)
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // D1 Database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgemail-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],

  // R2 Storage (raw emails + attachments)
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "edgemail-storage"
    }
  ],

  // KV namespace for rate limiting (/api/send).
  // Create with: wrangler kv namespace create edgemail-rate-limit
  // Then paste the returned `id` into `id` below. The binding is optional at
  // runtime — when missing, the rate limiter logs a warning and allows
  // requests through (fail-open), so the Worker still boots without it.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],

  // Cloudflare Email Service (send_email) binding. Enabled by default so the
  // Deploy to Cloudflare button provisions everything in one click. The
  // binding itself is inert until a domain is added to Email Service and
  // `env.EMAIL.send()` is invoked.
  //
  // Runtime constraints (surfaced as friendly errors in the UI — see
  // `GET /api/send/capabilities` and `services/mailer/cloudflare.ts`):
  //   - Workers Paid plan is required to send to arbitrary recipients.
  //     Free / new accounts can still send to verified destination addresses
  //     in Cloudflare Email Routing for testing.
  //   - The sender domain must be added to Email Service (automatic SPF /
  //     DKIM / DMARC records are created for you).
  //
  // Comment this out if you never want the "cloudflare" provider; the mailer
  // then always falls back to Resend.
  // `remote: true` is required for `wrangler dev` to actually route sends
  // through the live Cloudflare Email Service. Without it the local runtime
  // stubs the binding and `env.EMAIL.send()` returns undefined, which shows
  // up as a confusing "Cannot read properties of undefined" error inside the
  // mailer. Production deploys ignore `remote` (they always hit the real
  // service), so this is a dev-only shim.
  "send_email": [
    { "name": "EMAIL", "remote": true }
  ],

  // Scheduled triggers. The retention sweep runs daily at 03:15 UTC.
  "triggers": {
    "crons": ["15 3 * * *"]
  },

  // NOTE: Email routing (catch-all) is configured in the Cloudflare dashboard,
  // not in wrangler.jsonc. Set up a catch-all rule pointing to this Worker
  // in your domain's Email Routing settings.

  // Environment variables (set via dashboard or .dev.vars)
  "vars": {
    "APP_NAME": "EdgeMail",
    "ADMIN_EMAIL": "admin@example.com",
    "D1_DATABASE_ID": "YOUR_D1_DATABASE_ID",
    "R2_BUCKET_NAME": "edgemail-storage"
  }
}
