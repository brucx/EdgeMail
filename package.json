{
  "name": "edgemail",
  "version": "0.1.0",
  "description": "Open-source domain email system for Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply edgemail-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply edgemail-db --remote",
    "db:studio": "drizzle-kit studio",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.5.0",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.0",
    "postal-mime": "^2.4.0",
    "radix-ui": "^1.4.3",
    "resend": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20250410.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.68.0",
    "@tanstack/react-router": "^1.114.0",
    "@tanstack/router-devtools": "^1.114.0",
    "@tanstack/router-plugin": "^1.114.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "drizzle-kit": "^0.30.0",
    "lucide-react": "^0.475.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.14.0"
  },
  "optionalDependencies": {
    "@cloudflare/workerd-darwin-arm64": "^1.20260412.1"
  }
}
